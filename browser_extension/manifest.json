{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.1.8",
  "description": "__MSG_extensionDescription__",
  "default_locale": "fr",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
